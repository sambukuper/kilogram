[Desktop Entry]
Name=Kilogram
Comment=Desktop version of Kilogram - ToS breaking Telegram client
TryExec=Kilogram
Exec=env DESKTOPINTEGRATION=1 Kilogram -- %U
Icon=com.kilogram.desktop
Terminal=false
StartupWMClass=Kilogram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=Kilogram -quit
Name=Quit Kilogram
Icon=application-exit
